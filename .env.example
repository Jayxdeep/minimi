# --- LLM ------------------------------------------------------------------
# DeepSeek, OpenAI-compatible. https://platform.deepseek.com
# Leave empty to run in echo mode (no model calls, no keys needed).
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
LLM_TIMEOUT_MS=60000

# --- Search (Phase 2+) ----------------------------------------------------
# Tavily. https://tavily.com
TAVILY_API_KEY=

# --- Server ---------------------------------------------------------------
PORT=3000
DB_PATH=./data/agent.db

# Delay between streamed chunks in echo mode. Set to 0 for snappy demos/tests.
STREAM_TOKEN_DELAY_MS=30
